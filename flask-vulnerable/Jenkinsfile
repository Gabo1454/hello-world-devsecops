
pipeline {
    agent any

    environment {
        PYTHON = 'C:\\Users\\gaboa\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe'
        PIPENV_VENV_IN_PROJECT = '1'
        PIPENV_YES = '1'
        PIPENV_NOSPIN = '1'
        PYTHONIOENCODING = 'utf-8'
        PYTHONUTF8 = '1'
        DOCKER = 'C:\\Users\\gaboa\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
    }

    stages {
        stage('Build') {
            steps {
                dir('flask-vulnerable') {
                    echo 'Preparando entorno Python y Pipenv'
                    bat '"%PYTHON%" -m pip install --upgrade --target "%WORKSPACE%\\flask-vulnerable\\jenkins-tools" pipenv'
                    bat 'set "PYTHONPATH=%WORKSPACE%\\flask-vulnerable\\jenkins-tools" && "%PYTHON%" -m pipenv --version'
                    bat 'set "PYTHONPATH=%WORKSPACE%\\flask-vulnerable\\jenkins-tools" && "%PYTHON%" -m pipenv verify'
                }
            }
        }

        stage('Dependency Management') {
            steps {
                dir('flask-vulnerable') {
                    echo 'Instalando dependencias desde Pipfile.lock'
                    bat 'set "PYTHONPATH=%WORKSPACE%\\flask-vulnerable\\jenkins-tools" && "%PYTHON%" -m pipenv sync --dev'
                    bat 'set "PYTHONPATH=%WORKSPACE%\\flask-vulnerable\\jenkins-tools" && "%PYTHON%" -m pipenv verify'
                }
            }
        }

        stage('Test') {
            steps {
                dir('flask-vulnerable') {
                    echo 'Ejecutando pruebas unitarias'
                    bat 'set "PYTHONPATH=%WORKSPACE%\\flask-vulnerable\\jenkins-tools" && "%PYTHON%" -m pipenv run python -m unittest -v'
                }
            }
        }

        stage('Analyze') {
            steps {
                dir('flask-vulnerable') {
                    echo 'Analizando dependencias con pip-audit'
                    bat 'set "PYTHONPATH=%WORKSPACE%\\flask-vulnerable\\jenkins-tools" && "%PYTHON%" -m pipenv run pip-audit'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('flask-vulnerable') {
                    echo 'Construyendo imagen Docker de Flask'
                    bat '"%DOCKER%" build -t flask-vulnerable:latest .'

                    echo 'Eliminando contenedor anterior si existe'
                    script {
                        bat(returnStatus: true, script: '"%DOCKER%" rm -f flask-vulnerable-ev3')
                    }

                    echo 'Desplegando aplicación Flask'
                    bat '"%DOCKER%" run -d --name flask-vulnerable-ev3 -p 5001:5000 flask-vulnerable:latest'
                }
            }
        }

        stage('OWASP ZAP') {
            steps {
                echo 'Preparando directorio para informes ZAP'
                bat 'if not exist "%WORKSPACE%\\zap-reports" mkdir "%WORKSPACE%\\zap-reports"'

                echo 'Ejecutando análisis de seguridad con OWASP ZAP'
                bat(returnStatus: true, script: '"%DOCKER%" run --rm -t -v "%WORKSPACE%\\zap-reports:/zap/wrk/:rw" ghcr.io/zaproxy/zaproxy:stable zap-full-scan.py -t http://host.docker.internal:5001/hello -r zap-report.html')
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'zap-reports/**', allowEmptyArchive: true
        }
    }
}
